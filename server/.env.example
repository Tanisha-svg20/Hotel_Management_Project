# ==============================================================================
# HotelPro Server Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=8001
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# Option 1: MongoDB Atlas Cloud (Recommended for Persistent Storage)
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details.
# Make sure to append '/hotelpro' before the query string to target the proper database.
# Example:
# MONGODB_URI=mongodb+srv://hotelpro_user:YourSecurePassword123@cluster0.abcde.mongodb.net/hotelpro?retryWrites=true&w=majority

# Option 2: Local Persistent MongoDB Daemon (if MongoDB Community Server is running)
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro

# In-Memory Fallback Control
# Set to 'false' if you want the server to fail fast if persistent DB is unreachable
# Set to 'true' to allow ephemeral in-memory fallback for local offline prototyping
ALLOW_IN_MEMORY_FALLBACK=true

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=hotelpro_super_secret_jwt_key_2026_capstone_secure
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# PAYMENT INTEGRATION
# ------------------------------------------------------------------------------
# 'dev_adapter' simulates real card charges without external API calls
# 'stripe' uses real or test-mode Stripe API keys
PAYMENT_PROVIDER=dev_adapter
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (SMTP)
# ------------------------------------------------------------------------------
# If left blank, the application uses a safe Development Console Logger.
# To enable live delivery via Gmail, Mailtrap, or SendGrid, provide credentials below:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HotelPro Reservations" <reservations@hotelpro.com>
